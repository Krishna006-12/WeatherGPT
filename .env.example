# WeatherGPT — server secrets (NEVER commit real keys)
# Copy to .env.local for local API server, or set in Vercel → Settings → Environment Variables

# Google Gemini (preferred LLM for /api/chat)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional fallback if Gemini key missing
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
