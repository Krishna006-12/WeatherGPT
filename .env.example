# ═══════════════════════════════════════════════════════════
# WeatherGPT — free AI (pick ANY one or more)
# Order used by server: Groq → OpenRouter → Gemini → OpenAI → rules
# ═══════════════════════════════════════════════════════════

# --- RECOMMENDED FREE (no credit card) ---
# 1) Groq — very fast Llama. https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile,llama-3.1-8b-instant

# 2) OpenRouter free models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free

# --- Google Gemini (optional; free tier has daily quota) ---
# Multiple keys: comma-separated or GEMINI_API_KEY_2
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
GEMINI_FREE_TIER=1
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Paid optional ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════
# OpenWeatherMap — LIVE accurate weather (recommended)
# https://home.openweathermap.org/api_keys
# Free tier: Current Weather + 5 day / 3 hour forecast
# (One Call 3.0 works automatically if your key has access)
# ═══════════════════════════════════════════════════════════
OPENWEATHER_API_KEY=
# Optional aliases also accepted by server:
# OPEN_WEATHER_API_KEY=
# OWM_API_KEY=

# SECURITY
# - Never commit real keys. If a key was ever pushed to git/Vercel logs publicly, ROTATE it.
# - Set the same names in Vercel Project → Settings → Environment Variables (Production).
# - Keys are read only on the server (api/*.js). They must not appear in frontend bundles.
# - DO NOT use VITE_OPENWEATHER_* — that would leak the key in the browser bundle.
