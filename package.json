{
  "name": "weathergpt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "api": "node scripts/local-api-server.mjs",
    "dev:full": "node scripts/local-api-server.mjs & vite",
    "ship": "npm run build && vercel --prod",
    "git:status": "git status -sb",
    "intel": "cd python-intel && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8090",
    "intel:test": "cd python-intel && python3 -m pytest -q",
    "intel:install": "cd python-intel && python3 -m pip install -r requirements.txt"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vercel": "^59.5.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
