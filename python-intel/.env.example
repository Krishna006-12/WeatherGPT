# WeatherGPT Python Intelligence — copy to .env (never commit secrets)
# This service does NOT need Gemini/Groq keys for v0.1 (deterministic only).
# If added later for optional phrasing, keep them server-side only — never return to clients.

INTEL_HOST=0.0.0.0
INTEL_PORT=8090
INTEL_LOG_LEVEL=info

# Request timeout budget (seconds) for outbound weather fetches if enabled
INTEL_HTTP_TIMEOUT_S=8.0
INTEL_REQUEST_TIMEOUT_S=15.0

# CORS: Node BFF / local Vite only — not required if Node proxies same-origin
INTEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Optional shared secret between Node api/* and this service (header X-Intel-Key)
# Leave empty for local open; set in production so browsers cannot call Python directly.
INTEL_SERVICE_KEY=

# Feature flags
INTEL_ALLOW_UPSTREAM_FETCH=false
# If true, /v1/preprocess may fetch Open-Meteo (no API key). Default false = client sends packs.

# NEVER put GEMINI_API_KEY / GROQ_API_KEY here for frontend exposure.
# LLM stays on Node api/chat.js until an explicit later design.
